<div class="mx-auto max-w-4xl px-5 pt-7 pb-20"
     data-controller="analyze-text word-history"
     data-word-history-loading-value="<%= t("word_history.loading") %>"
     data-action="turbo:before-stream-render@document->analyze-text#filterStream"
     data-analyze-text-progress-label-value="<%= t("analyses.in_progress") %>">
  <%= turbo_stream_from @stream_key %>

  <h1 class="mb-6"><%= t("app.name") %></h1>

  <%= form_with url: analysis_path, method: :post,
        class: "card card-border bg-base-100 mb-8",
        data: { analyze_text_target: "form", action: "submit->analyze-text#prepare turbo:submit-start->analyze-text#start turbo:submit-end->analyze-text#submissionFinished turbo:fetch-request-error->analyze-text#requestFailed" } do %>
    <fieldset class="card-body" data-analyze-text-target="controls">
      <%= hidden_field_tag :stream_key, @stream_key %>
      <%= hidden_field_tag :request_id, SecureRandom.uuid, data: { analyze_text_target: "requestId" } %>
      <%= label_tag :text, t("analyses.text_label"), class: "label" %>
      <%= text_area_tag :text, @text, rows: 10, lang: "ja", required: true,
            class: "textarea w-full",
            data: { analyze_text_target: "textInput" } %>

      <div class="card-actions justify-end">
        <%= submit_tag t("analyses.submit"), class: "btn btn-primary",
              data: { analyze_text_target: "submit" } %>
      </div>
    </fieldset>
  <% end %>

  <p hidden role="status" data-analyze-text-target="progress"><%= t("analyses.in_progress") %></p>
  <div id="analysis_results" aria-live="polite" data-analyze-text-target="results">
    <p class="text-base-content/70"><%= t("analyses.empty_results") %></p>
  </div>

  <dialog class="modal" data-word-history-target="dialog" aria-labelledby="word_history_title">
    <div class="modal-box max-w-3xl">
      <div class="mb-4 flex items-center justify-between gap-4">
        <h2 id="word_history_title" class="text-xl"><%= t("word_history.title") %></h2>
        <button type="button" class="btn btn-sm" autofocus data-action="word-history#close"><%= t("word_history.close") %></button>
      </div>
      <%= turbo_frame_tag "word_history", data: {
            word_history_target: "frame",
            action: "turbo:frame-load->word-history#formatDates turbo:frame-missing->word-history#failed turbo:fetch-request-error->word-history#failed"
          } %>
    </div>
  </dialog>
  <template data-word-history-target="errorTemplate">
    <p role="alert"><%= t("word_history.load_failed") %></p>
    <button type="button" class="btn btn-sm mt-3" data-action="word-history#reload"><%= t("word_history.retry") %></button>
  </template>

  <template data-analyze-text-target="errorTemplate">
    <%= render "analyses/error", message: "request_failed", request_id: nil %>
  </template>
</div>
