<div class="overflow-x-auto rounded-box border border-base-300 bg-base-100">
  <table class="table">
    <thead>
      <tr>
        <th><%= t("analyses.columns.surface") %></th>
        <th><%= t("analyses.columns.base_form") %></th>
        <th><%= t("analyses.columns.reading") %></th>
        <th><%= t("analyses.columns.part_of_speech") %></th>
        <th><%= t("analyses.columns.anki") %></th>
      </tr>
    </thead>

    <tbody>
      <% results.each do |result| %>
        <% token = result[:token] %>

        <tr class="hover:bg-base-200">
          <td lang="ja" class="text-lg font-medium"><%= token.surface %></td>
          <td lang="ja"><%= token.base_form %></td>
          <td lang="ja" class="text-base-content/70"><%= token.reading %></td>
          <td class="text-base-content/70"><%= token.part_of_speech %></td>
          <td>
            <% case result[:in_anki] %>
            <% when true %>
              <span class="badge badge-success badge-sm" title="<%= t("analyses.anki_status.included") %>">✓</span>
            <% when false %>
              <span class="badge badge-warning badge-soft badge-sm" title="<%= t("analyses.anki_status.not_included") %>">✗</span>
            <% else %>
              <span class="text-base-content/40" title="<%= t("analyses.anki_status.not_checked") %>">—</span>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
