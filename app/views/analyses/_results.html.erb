<%= form_with url: save_analysis_path, scope: :analysis, method: :post do |form| %>
  <%= form.hidden_field :text, value: analysis.text %>

  <% errors = analysis.errors.full_messages %>
  <% analysis.word_assessments.each do |assessment| %>
    <% errors.concat(assessment.errors.full_messages) %>
    <% errors.concat(assessment.word&.errors&.full_messages || []) %>
  <% end %>
  <% if errors.any? %>
    <div class="alert alert-error mb-3" role="alert">
      <ul>
        <% errors.uniq.each do |error| %>
          <li><%= error %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100">
    <table class="table">
      <thead>
        <tr>
          <th><%= t("analyses.columns.surface") %></th>
          <th><%= t("analyses.columns.base_form") %></th>
          <th><%= t("analyses.columns.reading") %></th>
          <th><%= t("analyses.columns.part_of_speech") %></th>
          <th><%= t("analyses.columns.anki") %></th>
          <th><%= t("analyses.columns.assessment") %></th>
        </tr>
      </thead>

      <tbody>
        <% analysis.word_assessments.each_with_index do |assessment, index| %>
          <% word = assessment.word %>
          <% field_name = "analysis[word_assessments_attributes][#{index}]" %>
          <% word_field_name = "#{field_name}[word_attributes]" %>

          <tr class="hover:bg-base-200">
            <td lang="ja" class="text-lg font-medium">
              <% assessment.surfaces.to_a.each_with_index do |surface, surface_index| %>
                <% if surface_index.positive? %><span>, </span><% end %>
                <%= surface %>
                <%= hidden_field_tag "#{field_name}[surfaces][]", surface %>
              <% end %>
            </td>
            <td lang="ja"><%= word&.lemma %></td>
            <td lang="ja" class="text-base-content/70">
              <% readings = (assessment.surface_readings || [ word&.dictionary_reading ]).reject(&:blank?) %>
              <%= readings.join(", ") %>
              <%= hidden_field_tag "#{field_name}[surface_readings][]", "" %>
              <% readings.each do |reading| %>
                <%= hidden_field_tag "#{field_name}[surface_readings][]", reading %>
              <% end %>
            </td>
            <td class="text-base-content/70"><%= word&.part_of_speech %></td>
            <td>
              <% case assessment.in_anki %>
              <% when true %>
                <span class="badge badge-success badge-sm" title="<%= t("analyses.anki_status.included") %>">✓</span>
              <% when false %>
                <span class="badge badge-warning badge-soft badge-sm" title="<%= t("analyses.anki_status.not_included") %>">✗</span>
              <% else %>
                <span class="text-base-content/40" title="<%= t("analyses.anki_status.not_checked") %>">—</span>
              <% end %>
              <%= hidden_field_tag "#{field_name}[in_anki]", assessment.in_anki %>
            </td>
            <td>
              <%= hidden_field_tag "#{word_field_name}[lemma]", word&.lemma %>
              <%= hidden_field_tag "#{word_field_name}[part_of_speech]", word&.part_of_speech %>
              <%= hidden_field_tag "#{word_field_name}[dictionary_reading]", word&.dictionary_reading %>
              <%= select_tag "#{field_name}[assessment_choice_id]",
                    options_from_collection_for_select(assessment_choices, :id, :label, assessment.assessment_choice_id),
                    prompt: t("analyses.assessment_prompt"),
                    class: "select select-bordered select-sm" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="mt-4 flex justify-end">
    <%= form.submit t("analyses.save"), class: "btn btn-primary" %>
  </div>
<% end %>
