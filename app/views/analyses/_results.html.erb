<div data-analyze-text-target="completion" data-analysis-request-id="<%= local_assigns[:request_id] %>">
  <% if local_assigns[:flashcards_unavailable] %>
    <%= render "shared/notice", tone: "warning", title: t("word_history.flashcards_unavailable_title"), message: t("analyses.flashcards_unavailable") %>
  <% end %>
  <% if analysis.word_assessments.empty? && analysis.grammar_assessments.empty? %>
    <div class="empty-state ui-panel" role="status">
      <h2><%= t("analyses.no_vocabulary_title") %></h2>
      <p><%= t("analyses.no_vocabulary") %></p>
    </div>
  <% else %>
<%= form_with url: save_analysis_path, scope: :analysis, method: :post, class: "results-panel ui-panel" do |form| %>
  <header class="results-heading">
    <h2><%= t("analyses.results_title") %></h2>
    <p><%= t("analyses.results_hint") %></p>
    <p class="table-scroll-hint"><%= t("analyses.table_scroll_hint") %></p>
  </header>
  <%= form.hidden_field :text, value: analysis.text %>

  <% errors = analysis.errors.full_messages %>
  <% analysis.word_assessments.each do |assessment| %>
    <% errors.concat(assessment.errors.full_messages) %>
    <% errors.concat(assessment.word&.errors&.full_messages || []) %>
  <% end %>
  <% analysis.grammar_assessments.each do |assessment| %>
    <% errors.concat(assessment.errors.full_messages) %>
  <% end %>
  <% if errors.any? %>
    <div class="ui-notice ui-notice--error" role="alert">
      <ul>
        <% errors.uniq.each do |error| %>
          <li><%= error %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if analysis.word_assessments.any? %>
  <div class="assessment-toolbar">
    <div>
      <%= label_tag :bulk_assessment, t("analyses.bulk_assessment_label"), class: "label" %>
      <%= select_tag :bulk_assessment,
            options_from_collection_for_select(assessment_choices, :id, :label),
            prompt: t("analyses.assessment_prompt"),
            class: "select select-bordered select-sm",
            data: { analyze_text_target: "bulkAssessment" } %>
    </div>
    <button type="button" class="btn btn-sm" data-action="analyze-text#applyAssessmentToUnselected">
      <%= t("analyses.apply_assessment") %>
    </button>
  </div>
  <% end %>

  <% if analysis.word_assessments.any? %>
  <h3 class="results-subheading"><%= t("analyses.vocabulary_title") %></h3>
  <% passage_counts = saved_passage_counts(analysis) %>
  <div class="vocabulary-scroll" tabindex="0" role="region" aria-label="<%= t("analyses.results_title") %>">
    <table class="table vocabulary-table">
      <thead>
        <tr>
          <th><%= t("analyses.columns.surface") %></th>
          <th><%= t("analyses.columns.base_form") %></th>
          <th><%= t("analyses.columns.reading") %></th>
          <th><%= t("analyses.columns.part_of_speech") %></th>
          <th><%= t("analyses.columns.flashcards") %></th>
          <th><%= t("analyses.columns.assessment") %></th>
          <th title="<%= t("word_history.saved_only") %>"><%= t("analyses.columns.passages") %></th>
        </tr>
      </thead>

      <tbody>
        <% analysis.word_assessments.each_with_index do |assessment, index| %>
          <% word = assessment.word %>
          <% field_name = "analysis[word_assessments_attributes][#{index}]" %>
          <% word_field_name = "#{field_name}[word_attributes]" %>

          <tr class="hover:bg-base-200">
            <td lang="ja" class="text-lg font-medium">
              <% assessment.surfaces.to_a.each_with_index do |surface, surface_index| %>
                <% if surface_index.positive? %><span>, </span><% end %>
                <%= surface %>
                <%= hidden_field_tag "#{field_name}[surfaces][]", surface %>
              <% end %>
            </td>
            <td lang="ja">
              <button type="button" class="link link-primary" aria-haspopup="dialog"
                      data-action="word-history#open"
                      data-word-history-url="<%= word_history_path(lemma: word&.lemma, part_of_speech: word&.part_of_speech) %>">
                <%= word&.lemma %>
              </button>
            </td>
            <td lang="ja" class="text-base-content/70">
              <% readings = assessment.surface_readings.to_a.reject(&:blank?) %>
              <%= readings.join(", ") %>
              <%= hidden_field_tag "#{field_name}[surface_readings][]", "" %>
              <% readings.each do |reading| %>
                <%= hidden_field_tag "#{field_name}[surface_readings][]", reading %>
              <% end %>
            </td>
            <td class="text-base-content/70"><%= word&.part_of_speech %></td>
            <td>
              <% case assessment.in_flashcards %>
              <% when true %>
                <span class="badge badge-success badge-sm" title="<%= t("analyses.flashcard_status.included") %>">✓</span>
              <% when false %>
                <span class="badge badge-ghost badge-sm" title="<%= t("analyses.flashcard_status.not_included") %>">✗</span>
              <% else %>
                <span class="membership-unchecked" title="<%= t("analyses.flashcard_status.not_checked") %>"><%= t("analyses.flashcard_status.not_checked") %></span>
              <% end %>
              <%= hidden_field_tag "#{field_name}[in_flashcards]", assessment.in_flashcards %>
            </td>
            <td>
              <%= hidden_field_tag "#{word_field_name}[lemma]", word&.lemma %>
              <%= hidden_field_tag "#{word_field_name}[part_of_speech]", word&.part_of_speech %>
              <%= select_tag "#{field_name}[assessment_choice_id]",
                    options_from_collection_for_select(assessment_choices, :id, :label, assessment.assessment_choice_id),
                    required: true,
                    prompt: t("analyses.assessment_prompt"),
                    class: "select select-bordered select-sm",
                    data: { analyze_text_target: "assessment" } %>
            </td>
            <td class="tabular-nums" data-passage-count><%= passage_counts.fetch(word&.id, 0) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% end %>

  <% if analysis.grammar_assessments.any? %>
    <section class="grammar-results" aria-labelledby="grammar-results-title">
      <h3 id="grammar-results-title"><%= t("analyses.grammar_title") %></h3>
      <ul class="grammar-assessment-list">
        <% analysis.grammar_assessments.each_with_index do |assessment, index| %>
          <% field_name = "analysis[grammar_assessments_attributes][#{index}]" %>
          <li class="grammar-assessment">
            <div class="grammar-assessment-content">
              <h4 lang="ja"><%= assessment.pattern %></h4>
              <p class="grammar-example" lang="ja"><%= assessment.example %></p>
              <p><strong><%= assessment.meaning %></strong></p>
              <p><%= assessment.explanation %></p>
            </div>
            <div class="grammar-assessment-choice">
              <%= hidden_field_tag "#{field_name}[pattern]", assessment.pattern %>
              <%= hidden_field_tag "#{field_name}[meaning]", assessment.meaning %>
              <%= hidden_field_tag "#{field_name}[explanation]", assessment.explanation %>
              <%= hidden_field_tag "#{field_name}[example]", assessment.example %>
              <%= label_tag "#{field_name}[grammar_assessment_choice_id]", t("analyses.grammar_assessment_label"), class: "label" %>
              <%= select_tag "#{field_name}[grammar_assessment_choice_id]",
                    options_from_collection_for_select(grammar_assessment_choices, :id, :label, assessment.grammar_assessment_choice_id),
                    required: true,
                    prompt: t("analyses.assessment_prompt"),
                    class: "select select-bordered select-sm" %>
            </div>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <div class="results-footer">
    <%= form.submit t("analyses.save"), class: "btn btn-primary" %>
  </div>
<% end %>
  <% end %>
</div>
