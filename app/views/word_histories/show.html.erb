<%= turbo_frame_tag "word_history" do %>
  <h3 class="mb-1 text-2xl" lang="ja"><%= @word.lemma %></h3>
  <p class="mb-4 text-base-content/70" lang="ja"><%= @word.part_of_speech %></p>
  <p class="mb-4 text-sm text-base-content/70"><%= t("word_history.saved_only") %></p>

  <dl class="mb-6 grid grid-cols-2 gap-3">
    <dt><%= t("word_history.passages") %></dt><dd data-history-passage-count><%= @history.size %></dd>
    <dt><%= t("word_history.first_encounter") %></dt>
    <dd><%= @history.any? ? time_tag(@history.last.analysis.created_at, format: "%Y-%m-%d %H:%M %Z") : t("word_history.never") %></dd>
    <dt><%= t("word_history.last_encounter") %></dt>
    <dd><%= @history.any? ? time_tag(@history.first.analysis.created_at, format: "%Y-%m-%d %H:%M %Z") : t("word_history.never") %></dd>
  </dl>

  <h4 class="mb-2 text-lg"><%= t("word_history.choice_summary") %></h4>
  <% if @history.empty? %>
    <p class="mb-6"><%= t("word_history.no_history") %></p>
  <% else %>
    <ul class="mb-6">
      <% @choice_counts.each do |key, count| %>
        <li><%= key ? t("assessment_choices.#{key}") : t("word_history.unassessed") %>: <%= count %></li>
      <% end %>
    </ul>
    <h4 class="mb-2 text-lg"><%= t("word_history.timeline") %></h4>
    <div class="mb-6 overflow-x-auto">
      <table class="table table-sm">
        <thead><tr><th><%= t("word_history.saved_at") %></th><th><%= t("analyses.columns.assessment") %></th><th><%= t("word_history.passage") %></th></tr></thead>
        <tbody>
          <% @history.each do |assessment| %>
            <tr>
              <td><%= time_tag assessment.analysis.created_at, format: "%Y-%m-%d %H:%M %Z" %></td>
              <td><%= assessment.assessment_choice&.label || t("word_history.unassessed") %></td>
              <td>
                <details>
                  <summary class="cursor-pointer"><%= t("word_history.view_passage") %></summary>
                  <p class="mt-2 whitespace-pre-wrap" lang="ja"><%= assessment.analysis.text %></p>
                </details>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <h4 class="mb-2 text-lg"><%= t("analyses.columns.flashcards") %></h4>
  <% if @flashcards.unavailable? %>
    <p role="status"><%= t("analyses.flashcards_unavailable") %></p>
  <% elsif !@flashcards.checked? %>
    <p role="status"><%= t("word_history.flashcards_not_configured") %></p>
  <% elsif !@flashcards.include?(@word.lemma) %>
    <p role="status"><%= t("analyses.flashcard_status.not_included") %></p>
  <% else %>
    <p class="mb-2"><%= t("analyses.flashcard_status.included") %> (<%= @flashcards.provider&.humanize %>)</p>
    <% @flashcards.notes_for(@word.lemma).each do |note| %>
      <details class="mb-3">
        <summary class="cursor-pointer"><%= t("word_history.note") %> <%= note["noteId"] %> <%= note["modelName"] %></summary>
        <dl class="mt-2 space-y-2">
          <% note.fetch("fields", {}).each do |name, field| %>
            <dt class="font-medium"><%= name %></dt><dd class="whitespace-pre-wrap"><%= strip_tags(field["value"].to_s) %></dd>
          <% end %>
          <% if note["tags"].present? %>
            <dt class="font-medium"><%= t("word_history.tags") %></dt><dd><%= note["tags"].join(", ") %></dd>
          <% end %>
        </dl>
      </details>
    <% end %>
  <% end %>
<% end %>
